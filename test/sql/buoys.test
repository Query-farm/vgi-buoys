# NOAA fixture assertions over stdio, launch and HTTP.
require vgi

require-env BUOYS_WORKER

statement ok
INSTALL icu FROM core;

statement ok
LOAD icu;

statement ok
SET TimeZone='UTC';

statement ok
ATTACH 'buoys' (TYPE vgi, LOCATION '{BUOYS_WORKER}');

# stations capability and XML
query TTIT
SELECT station_id, name, CAST(has_met AS INTEGER), CAST(has_currents AS INTEGER) FROM buoys.main.stations() ORDER BY station_id;
----
41001	East Hatteras	1	NULL
44013	Boston & Harbor	1	0
tplm2	Thomas Point	1	NULL

# latest normalizes IDs preserves missing
query TII
SELECT station_id, CAST(wind_speed_mps AS INTEGER), CAST(wave_height_m*10 AS INTEGER) FROM buoys.main.latest_observations() ORDER BY station_id;
----
44013	5	15
tplm2	0	NULL

# station latest filter
query T
SELECT station_id FROM buoys.main.latest_observations(station_id := 'TPLM2');
----
tplm2

# observation UTC and units
query TIII
SELECT strftime(time,'%Y-%m-%d %H:%M:%S'), CAST(visibility_m AS INTEGER), CAST(round(water_level_m*10000) AS INTEGER), CAST(dominant_period_s AS INTEGER) FROM buoys.main.observations('44013') ORDER BY time DESC LIMIT 1;
----
2026-01-02 00:00:00	3704	9144	8

# inclusive time filters
query III
SELECT count(*),count(wave_height_m),CAST(sum(wave_height_m) AS INTEGER) FROM buoys.main.observations('44013', start_time := '2026-01-01T00:10:00Z', end_time := '2026-01-01T00:20:00Z');
----
2	1	0

# large Arrow batch
query III
SELECT count(*),count(DISTINCT time), CAST(sum(wave_height_m)*10 AS BIGINT) FROM buoys.main.observations('large');
----
5001	5001	75015

# drifting layout
query IITI
SELECT CAST(latitude*100 AS INTEGER), CAST(longitude*100 AS INTEGER), strftime(time,'%H:%M'), CAST(wave_height_m*10 AS INTEGER) FROM buoys.main.observations('drift');
----
2599	-8966	00:30	12

# empty history
query I
SELECT count(*) FROM buoys.main.observations('empty');
----
0

# empty filtered latest
query I
SELECT count(*) FROM buoys.main.latest_observations(station_id := 'absent');
----
0

# join metadata and observation
query TI
SELECT s.name, CAST(o.wind_speed_mps AS INTEGER) FROM buoys.main.stations() s JOIN buoys.main.latest_observations() o USING(station_id) ORDER BY s.name;
----
Boston & Harbor	5
Thomas Point	0

# timestamp and provenance
query IT
SELECT CAST(bool_and(fetched_at IS NOT NULL AND source_url LIKE '%44013.txt') AS INTEGER), typeof(min(time)) FROM buoys.main.observations('44013');
----
1	TIMESTAMP WITH TIME ZONE

statement error
SELECT * FROM buoys.main.observations(NULL);
----
<REGEX>:.*

statement error
SELECT * FROM buoys.main.latest_observations(station_id := NULL);
----
<REGEX>:.*

statement error
SELECT * FROM buoys.main.observations('../abc');
----
<REGEX>:.*

statement error
SELECT * FROM buoys.main.observations('absent');
----
HTTP 404

statement error
SELECT * FROM buoys.main.observations('44013', start_time := '2026-01-01T00:00:00');
----
UTC ISO

statement error
SELECT * FROM buoys.main.observations('44013', start_time := '2026-01-02T00:00:00Z', end_time := '2026-01-01T00:00:00Z');
----
end_time


query TTTI
SELECT column_name, source_unit, output_unit, scale FROM buoys.main.measurements WHERE column_name = 'visibility_m';
----
visibility_m	nmi	m	1852

# composed: largest seas named from the station directory (src/composed.ts LARGEST_SEAS_NAMED)
query TTTTTRR
SELECT o.station_id, s.name, s.owner, s.station_type, o.time, o.wave_height_m, o.dominant_period_s FROM buoys.main.latest_observations() AS o JOIN buoys.main.stations AS s USING (station_id) WHERE o.wave_height_m IS NOT NULL ORDER BY o.wave_height_m DESC, o.station_id LIMIT 10;
----
44013	Boston & Harbor	NDBC	buoy	2026-01-02 00:00:00+00	1.5	8.0

# composed: has_met stations missing from the latest file (SILENT_MET_STATIONS)
query TTTT
SELECT s.station_id, s.name, s.owner, s.station_type FROM buoys.main.stations AS s ANTI JOIN buoys.main.latest_observations() AS o USING (station_id) WHERE s.has_met ORDER BY s.station_id;
----
41001	East Hatteras	NDBC	buoy

# composed: daily history with directory name and coordinates (DAILY_HISTORY_WITH_STATION)
query TTRRTRRI
SELECT s.station_id, s.name, s.latitude, s.longitude, date_trunc('day', o.time) AS obs_day, max(o.wave_height_m) AS max_wave_height_m, avg(o.wind_speed_mps) AS mean_wind_speed_mps, count(*) AS reports FROM buoys.main.observations('44013') AS o JOIN buoys.main.stations AS s USING (station_id) GROUP BY ALL ORDER BY obs_day DESC LIMIT 7;
----
44013	Boston & Harbor	42.346	-70.651	2026-01-02 00:00:00+00	1.5	5.0	1
44013	Boston & Harbor	42.346	-70.651	2026-01-01 00:00:00+00	1.0	2.0	3

# composed: latest report unpivoted and joined to units (LATEST_WITH_UNITS); 46026 is absent from the fixture
query I
SELECT count(*) FROM (SELECT v.column_name, v.value, m.output_unit, m.source_field, m.source_unit, m.scale FROM (UNPIVOT buoys.main.latest_observations(station_id := '46026') ON COLUMNS(* EXCLUDE (station_id, time, latitude, longitude, source_url, fetched_at)) INTO NAME column_name VALUE value) AS v JOIN buoys.main.measurements AS m USING (column_name) ORDER BY v.column_name);
----
0

# same shape on the fixture station: NULL measurements drop out, units and scales come from measurements
query TRTTTR
SELECT v.column_name, v.value, m.output_unit, m.source_field, m.source_unit, m.scale FROM (UNPIVOT buoys.main.latest_observations(station_id := 'tplm2') ON COLUMNS(* EXCLUDE (station_id, time, latitude, longitude, source_url, fetched_at)) INTO NAME column_name VALUE value) AS v JOIN buoys.main.measurements AS m USING (column_name) ORDER BY v.column_name;
----
air_temperature_c	-2.0	degC	ATMP	degC	1.0
dew_point_c	-3.0	degC	DEWP	degC	1.0
pressure_hpa	1011.0	hPa	PRES	hPa	1.0
pressure_tendency_hpa	-1.0	hPa	PTDY	hPa	1.0
water_temperature_c	5.0	degC	WTMP	degC	1.0
wind_gust_mps	0.0	m/s	GST	m/s	1.0
wind_speed_mps	0.0	m/s	WSPD	m/s	1.0
